{
  "custom/app-launcher": {
    "format": "<span size='16000'></span>",
    "on-click": "pgrep rofi >/dev/null 2>&1 && killall rofi || ~/.config/rofi/scripts/launcher_t1",
    "tooltip-format": "Application Launcher"
  },
  "custom/dots": {
    "format": "󰇙"
  },
  "custom/mediaplayer": {
    "format": "{icon} {text}",
    "return-type": "json",
    "max-length": 40,
    "format-icons": {
      "spotify": "<span color='#1ed760'></span>",
      "default": "<span color='#7aa2f7'>🎜</span>"
    },
    // "exec": "python ~/.config/waybar/mediaplayer.py --player spotify 2> /dev/null",
    // "on-click": "playerctl -p spotify play-pause",
    // "on-scroll-down": "playerctl -p spotify next",
    // "on-scroll-up": "playerctl -p spotify previous",
    "exec": "python ~/.config/waybar/mediaplayer.py 2> /dev/null",
    "on-click": "playerctl play-pause",
    "on-scroll-down": "playerctl next",
    "on-scroll-up": "playerctl previous",
    "smooth-scrolling-threshold": 1
  },
  "hyprland/workspaces": {
    "format": "<span size='8000'>{icon}</span>",
    "on-click": "activate",
    "all-outputs": true,
    "format-icons": {
      "1": "<span size='8000'></span>",
      "2": "<span size='8000'></span>",
      "3": "<span size='8000'></span>",
      "4": "<span size='8000'></span>",
      "5": "<span size='8000'></span>",
      "6": "<span size='8000'></span>",
      "7": "<span size='8000'></span>",
      "8": "<span size='8000'></span>",
      "9": "<span size='8000'></span>",
      "10": "<span size='8000'></span>",
      "active": "<span size='14000'></span>"
    },
    "sort-by-number": true
  },
  "clock": {
    "interval": 1,
    "format": "<span size='10000' color='#7aa2f7'>󰸗</span>  {:%a %d %b %H:%M:%S}",
    "tooltip": false,
    "on-click": "pkill gnome-calendar || gnome-calendar"
  },
  "group/power": {
    "orientation": "horizontal",
    "modules": ["battery", "power-profiles-daemon"]
  },
  "group/group1": {
    "orientation": "horizontal",
    "modules": ["group/power", "tray"]
  },
  "group/group2": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "group/group1"]
  },
  "group/group3": {
    "orientation": "horizontal",
    "modules": ["backlight", "group/group2"]
  },
  "network": {
    "interval": 1,
    "format-wifi": "<span size='10000' color='#ffa500'></span>  {bandwidthDownBytes}",
    "format-ethernet": "<span size='10000' color='#ffa500'></span>  {bandwidthDownBytes}",
    "tooltip": false,
    "format-disconnected": ""
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": [
      "<span color='#ffd700' size='10000'>󰃚</span>",
      "<span color='#ffd700' size='10000'>󰃛</span>",
      "<span color='#ffd700' size='10000'>󰃜</span>",
      "<span color='#ffd700' size='10000'>󰃝</span>",
      "<span color='#ffd700' size='10000'>󰃞</span>",
      "<span color='#ffd700' size='10000'>󰃟</span>",
      "<span color='#ffd700' size='10000'>󰃠</span>"
    ],
    "scroll-step": 5,
    "tooltip-format": "Brightness: {percent}%"
  },
  "pulseaudio#input": {
    "format-source": "<span size='10000' color='#00ff00'></span><span> {volume}%</span>",
    "format-source-muted": "<span size='10000'>󰍭 Muted</span>",
    "format": "{format_source}",
    "on-click": "pamixer --default-source -t",
    "on-click-right": "~/.local/bin/audio-switcher both",
    "on-scroll-up": "pamixer --default-source -i 5",
    "on-scroll-down": "pamixer --default-source -d 5",
    "scroll-step": 5
  },
  "pulseaudio#output": {
    "max-volume": 150,
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "~/.local/bin/audio-switcher both",
    "format": "{icon}  {volume}%",
    "format-bluetooth": "<span size='10000' color='#1e90ff'></span> {volume}%",
    "format-bluetooth-muted": "  Muted",
    "format-muted": "  Muted",
    "format-icons": {
      "hands-free": "󰋎",
      "headphone": "<span color='#f4be49'></span>",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "<span color='#00ff7f' size='10000'></span>",
        "<span color='#00ff00' size='10000'></span>",
        "<span color='#7fff00' size='10000'></span>",
        "<span color='#b2ff66' size='10000'></span>",
        "<span color='#ffff66' size='10000'></span>",
        "<span color='#ffc300' size='10000'></span>",
        "<span color='#ff8c00' size='10000'></span>",
        "<span color='#ff5733' size='10000'></span>",
        "<span color='#ff0000' size='10000'></span>"
      ]
    }
  },
  "battery": {
    "full-at": 98,
    "interval": 1,
    "states": {
      "critical": 15,
      "warning": 30,
      "minor": 40,
      "moderate": 60,
      "high": 80,
      "good": 98,
      "excelent": 100
    },
    "format": "<span size='10000'>{icon}</span> {capacity}%",
    "format-full": "<span size='10000' color='#00ff7f'>󰁹</span> {capacity}%",
    "format-charging-critical": "<span size='10000'>󰢟</span> {capacity}%",
    "format-charging-warning": "<span size='10000'>󰂆</span> {capacity}%",
    "format-charging-minor": "<span size='10000'>󰂇</span> {capacity}%",
    "format-charging-moderate": "<span size='10000'>󰢝</span> {capacity}%",
    "format-charging-high": "<span size='10000'>󰢞</span> {capacity}%",
    "format-charging-good": "<span size='10000'>󰂋</span> {capacity}%",
    "format-icons": {
      "critical": "󰂃",
      "warning": "<span color='#ff5733'>󰁺</span>",
      "minor": "<span color='#ffc300'>󰁼</span>",
      "moderate": "<span color='#b2ff66'>󰁾</span>",
      "high": "<span color='#00ff00'>󰂀</span>",
      "good": "<span color='#00ff7f'>󰂂</span>",
      "excelent": "<span color='#00ff7f'>󰁹</span>"
    }
  },
  "power-profiles-daemon": {
    "format": "<span size='10000' color='#6c77bb'>{icon}</span>",
    // TODO: Remove driver from the tooltip
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "format-icons": {
      "default": " ",
      "performance": " ",
      "balanced": " ",
      "power-saver": "<span size='13000'>󱈑</span>"
    }
  },
  "tray": {
    "icon-size": 15,
    "spacing": 5,
    "reverse-direction": false,
    "orders": {
      "nm-applet": 100,
      "blueman": 90
    }
  },
  "custom/power-menu": {
    "format": "<span size='14000'>⏻</span>",
    "on-click": "wlogout",
    "tooltip-format": "Power Menu"
  },
  "custom/notifications": {
    "exec": "~/.config/waybar/notif.sh count",
    "interval": 5,
    "return-type": "json",
    "format": "<span color='#7c9eff'>{icon}</span> <span size='9500' color='white'>{text}</span>",
    "format-icons": { "default": "<span size='10000'>󰂚</span>" },
    "on-click": "~/.local/bin/notif-center",
    "tooltip": false
  }
}
